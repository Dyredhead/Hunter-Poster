{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/*"],
            "@/database/*": ["./src/database/*"],
            "@/middleware/*": ["./src/middleware/*"],
            "@/repositories/*": ["./src/repositories/*"],
            "@/routes/*": ["./src/routes/*"]
        }
    },
    "include": ["src"],
    "references": [{ "path": "../shared" }]
}
